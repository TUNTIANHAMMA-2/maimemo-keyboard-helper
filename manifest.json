{
  "manifest_version": 3,
  "name": "墨墨学习助手",
  "description": "墨墨网页版可配置快捷键、公测页自动进入、全屏净化、阅读卡片、三色操作按钮与明暗主题。",
  "version": "0.3.3",
  "icons": {
    "48": "assets/maimemo-logo.png",
    "96": "assets/maimemo-logo.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.maimemo.com/home/web_study*",
    "https://tc-apis.maimemo.com/webstudy/app*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "maimemo-keyboard-helper@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "墨墨学习助手",
    "default_icon": {
      "16": "assets/maimemo-logo.png",
      "32": "assets/maimemo-logo.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.maimemo.com/home/web_study*",
        "https://tc-apis.maimemo.com/webstudy/app*"
      ],
      "css": ["content/maimemo-page.css", "core/liquid-glass.css"],
      "js": ["core/shortcut-utils.js", "core/settings.js", "content/liquid-glass.js", "content/maimemo-page.js", "content/maimemo-shortcuts.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/maimemo-logo.png"],
      "matches": ["https://tc-apis.maimemo.com/*"]
    }
  ]
}
